  "component_tiers": {
    "$comment": "VMR src/ directories by how directly they map to the bounty's wording. Tier names are this lab's, not MSRC's. Verified against src/vmr/*/src/source-manifest.json.",
    "tier1_core": {
      "meaning": "The product the program names: the .NET runtime + base class libraries, and ASP.NET Core.",
      "components": [
        "runtime",
        "aspnetcore"
      ]
    },
    "tier2_shipped_product": {
      "meaning": "Ships in the .NET installers, or is named by the program (templates, GitHub Actions). In scope; show the impact is in .NET itself.",
      "components": [
        "sdk",
        "templating",
        "windowsdesktop",
        "winforms",
        "wpf"
      ]
    },
    "tier3_toolchain": {
      "meaning": "Toolchain or separate products bundled with, or built alongside, the SDK. The program does not name them; confirm with MSRC before investing heavily.",
      "components": [
        "roslyn",
        "msbuild",
        "nuget-client",
        "razor",
        "fsharp",
        "emsdk",
        "efcore",
        "diagnostics",
        "deployment-tools",
        "command-line-api",
        "vstest",
        "sourcelink",
        "symreader",
        "xdt",
        "cecil"
      ]
    },
    "out_of_scope_in_tree": {
      "meaning": "Build infrastructure and vendored third-party code. Excluded as 'platform technologies not unique to .NET' or third-party issues without a .NET-specific impact.",
      "components": [
        "arcade",
        "scenario-tests",
        "source-build-assets"
      ],
      "paths": [
        "src/runtime/src/native/external",
        "src/aspnetcore/src/submodules",
        "src/source-build-assets"
      ]
    }
  },
  "shipped_artifacts": {
    "templates": {
      "from": "installed SDKs (.dotnet/templates/<runtime>/*.nupkg)",
      "dest": "shipped/templates",
      "basis": "templates"
    },
    "binaries": {
      "dest": "shipped/binaries",
      "basis": "current",
      "rids": [
        "win-x64",
        "linux-x64",
        "osx-arm64"
      ],
      "products": [
        "runtime",
        "aspnetcore-runtime",
        "windowsdesktop",
        "aspnetcore-hosting-bundle"
      ],
      "note": "official release archives from release metadata, SHA-512 verified; SDK archives are installed under .dotnet"
    },
    "known_cves": {
      "from": "release metadata cve-list for every release of each in-scope channel",
      "dest": "scope/known-cves.json",
      "why": "'Publicly-disclosed vulnerabilities ... already known' are out of scope"
    }
  },
  "not_covered": [
    {
      "what": ".NET Aspire, .NET MAUI, dotnet/extensions (Microsoft.Extensions.AI etc.), Orleans, YARP, ML.NET, EF Core 2.x, Docker images",
      "why": "Separate products with their own release cycles; not named by the .NET bounty page"
    },
    {
      "what": "docs-aspire, docs-maui",
      "why": "Documentation for products outside the program"
    },
    {
      "what": "main / nightly branches of product repos",
      "why": "Daily builds are excluded; only their GitHub Actions (which run from main) are in scope"
    }
  ]
}
